# ---- Upstash Redis (хранение состояния и push-подписок) ----
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ---- Upstash QStash (отложенные уведомления), EU-регион ----
QSTASH_URL=https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---- Web Push (VAPID). Сгенерировать: npx web-push generate-vapid-keys ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Необязательно: публичный адрес приложения для callback QStash ----
# По умолчанию берётся из заголовков запроса / VERCEL_PROJECT_PRODUCTION_URL
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
